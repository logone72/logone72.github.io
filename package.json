{
  "name": "logone72",
  "version": "1.1.7",
  "description": "frontend developer logone72's blog",
  "type": "module",
  "repository": "https://github.com/logone72/logone72.github.io.git",
  "author": "Roegan Kim <roegan.kim@gmail.com>",
  "keywords": [
    "blog",
    "development",
    "vitepress",
    "vue"
  ],
  "homepage": "https://logone72.github.io",
  "bugs": {
    "url": "https://github.com/logone72/logone72.github.io/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "node scripts/dev-server.mjs site",
    "dev:home": "node scripts/dev-server.mjs home",
    "dev:blog": "node scripts/dev-server.mjs blog",
    "build": "npm run build:home && npm run build:blog && npm run assemble",
    "build:home": "vite build --config apps/home/vite.config.ts",
    "build:blog": "vitepress build apps/blog",
    "assemble": "node scripts/assemble-dist.mjs",
    "preview": "vite preview --host 0.0.0.0 --outDir dist",
    "preview:home": "vite preview --config apps/home/vite.config.ts --host 0.0.0.0",
    "preview:blog": "vitepress preview apps/blog --host 0.0.0.0",
    "markdownlint": "markdownlint '**/*.md'",
    "markdownlint:fix": "markdownlint --fix '**/*.md'",
    "prepare": "husky"
  },
  "contributors": [
    "Roegan Kim <roegan.kim@gmail.com>"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.9.1",
    "@naverpay/markdown-lint": "^1.0.0",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "prettier": "3.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitepress": "^2.0.0-alpha.17",
    "vitepress-sidebar": "^1.33.0",
    "vue": "^3.5.34"
  }
}
